# Supabase → Project Settings → API Keys
# Publishable key (sb_publishable_...) atau anon key lama — keduanya bisa.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret key (sb_secret_...) atau service_role lama.
# JANGAN pernah diberi prefix NEXT_PUBLIC_. Kunci ini mem-bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Opsional: dipakai saat membuat link QR. Kalau kosong, diambil dari header host.
NEXT_PUBLIC_SITE_URL=https://kamera.acaramu.com
